package conformance.run
import system as sys
from system import cmd as command

def probe():
  configured = command'printf "%s" #{"opaque ; value"}'.with(cwd: "/tmp", env: {"AMBER_TEST": "value"})
  ran = sys.shell("exit 0").run(timeout: 3.0)
  first = sys.command("/bin/sleep", "5", group: "new").spawn()
  first.terminate()
  terminated = first.wait(timeout: 3.0)
  first.close()
  second = command'sleep 5'.spawn()
  second.kill()
  killed = second.wait(timeout: 3.0)
  second.close()
  work = task.async:
    value = command'printf scoped'.spawn(timeout: 3.0) |process|:
      process.communicate().stdout.to_str()
    try:
      command'sleep 5'.spawn(timeout: 3.0) |process|:
        raise ValueError.new("scoped handler")
    rescue ValueError:
      1
    value + command'printf after'.output()
  scoped = work.wait()
  if configured.argv[2] == "opaque ; value" and configured.output() == "opaque ; value" and ran.success?() and terminated.signaled?() and killed.signaled?() and scoped == "scopedafter":
    42
  else:
    0
