{
  "name": "sputnik-lang",
  "displayName": "Sputnik",
  "description": "Syntax highlighting and run/build tasks for the Sputnik programming language.",
  "version": "0.1.0",
  "publisher": "sputnik-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/orlando-labs/amber-lang.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sputnik",
    "programming-language"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sputnik"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sputnik",
        "aliases": [
          "Sputnik",
          "sputnik"
        ],
        "extensions": [
          ".s",
          ".spu",
          ".sputnik"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sputnik",
        "scopeName": "source.sputnik",
        "path": "./syntaxes/sputnik.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sputnik.runFile",
        "title": "Sputnik: Run File",
        "category": "Sputnik"
      },
      {
        "command": "sputnik.buildFile",
        "title": "Sputnik: Build File",
        "category": "Sputnik"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "sputnik.runFile",
          "when": "resourceLangId == sputnik",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "sputnik.runFile",
          "when": "resourceLangId == sputnik",
          "group": "sputnik@1"
        },
        {
          "command": "sputnik.buildFile",
          "when": "resourceLangId == sputnik",
          "group": "sputnik@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sputnik.runFile",
          "when": "resourceLangId == sputnik"
        },
        {
          "command": "sputnik.buildFile",
          "when": "resourceLangId == sputnik"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "sputnik",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build"
            ],
            "description": "Which sputnik action to perform for this task."
          },
          "file": {
            "type": "string",
            "description": "Path to the .s file. Defaults to the active editor's file."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra arguments passed to sputnik."
          }
        }
      }
    ],
    "configuration": {
      "title": "Sputnik",
      "properties": {
        "sputnik.compilerPath": {
          "type": "string",
          "default": "sputnik",
          "description": "Path to the sputnik executable. If not absolute and not found on PATH, the extension falls back to '<workspace>/build/sputnik'."
        },
        "sputnik.build.target": {
          "type": "string",
          "enum": [
            "native",
            "native-debug",
            "bytecode-wrapper"
          ],
          "default": "native",
          "description": "Target passed to 'sputnik build --target'."
        },
        "sputnik.build.outDir": {
          "type": "string",
          "default": "build",
          "description": "Directory (relative to the workspace folder, or absolute) where build artifacts are written."
        },
        "sputnik.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended when running a file with 'sputnik <file>'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "node test/grammar.test.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
