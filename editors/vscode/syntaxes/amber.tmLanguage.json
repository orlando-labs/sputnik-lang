{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Amber",
  "scopeName": "source.amber",
  "patterns": [
    { "include": "#macro-definition" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#inline-conditional" },
    { "include": "#callable-references" },
    { "include": "#definition-function" },
    { "include": "#definition-native-class" },
    { "include": "#definition-class" },
    { "include": "#definition-property" },
    { "include": "#member-call" },
    { "include": "#member-access" },
    { "include": "#keyword-contextual" },
    { "include": "#keyword-control" },
    { "include": "#keyword-exception" },
    { "include": "#keyword-operator-word" },
    { "include": "#special-variables" },
    { "include": "#variables" },
    { "include": "#symbols" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#command-call" },
    { "include": "#keyword-declaration" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "macro-definition": {
      "name": "meta.definition.macro.amber",
      "begin": "^([ \\t]*)(?:(string_tag)\\s+)?(macro)\\s+(def)\\s+([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
      "end": "^(?!\\1[ \\t])(?!\\s*#)(?=\\s*\\S)",
      "beginCaptures": {
        "2": { "name": "storage.modifier.string-tag.amber" },
        "3": { "name": "storage.modifier.macro.amber" },
        "4": { "name": "storage.type.function.amber" },
        "5": { "name": "entity.name.function.macro.amber" }
      },
      "patterns": [
        { "include": "#macro-splice" },
        { "include": "$self" }
      ]
    },
    "macro-splice": {
      "name": "meta.embedded.expression.macro.amber",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.amber" }
      },
      "patterns": [
        { "include": "#balanced-braces" },
        { "include": "$self" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.shebang.amber",
          "match": "\\A#!.*$"
        },
        {
          "name": "comment.line.number-sign.amber",
          "begin": "(?<!\\S)#",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.amber" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#regexp-block" },
        { "include": "#tagged-string-block" },
        { "include": "#string-block" },
        { "include": "#regexp-string" },
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },
    "regexp-block": {
      "name": "string.regexp.block.amber",
      "begin": "(?<![\\p{L}\\p{N}_])(r)(\"\"\")",
      "end": "\"\"\"",
      "beginCaptures": {
        "1": { "name": "entity.name.function.macro.string-tag.amber" },
        "2": { "name": "punctuation.definition.string.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.amber" }
      },
      "patterns": [
        { "include": "#string-escape-raw" }
      ]
    },
    "tagged-string-block": {
      "name": "string.quoted.other.block.tagged.amber",
      "begin": "(?<![\\p{L}\\p{N}_])([\\p{L}_][\\p{L}\\p{N}_]*)(\"\"\")",
      "end": "\"\"\"",
      "beginCaptures": {
        "1": { "name": "entity.name.function.macro.string-tag.amber" },
        "2": { "name": "punctuation.definition.string.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.amber" }
      },
      "patterns": [
        { "include": "#string-escape-double" },
        { "include": "#interpolation" }
      ]
    },
    "string-block": {
      "name": "string.quoted.double.block.amber",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.amber" }
      },
      "patterns": [
        { "include": "#string-escape-double" },
        { "include": "#interpolation" }
      ]
    },
    "regexp-string": {
      "name": "string.regexp.amber",
      "begin": "(?<![\\p{L}\\p{N}_])(r)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": { "name": "entity.name.function.macro.string-tag.amber" },
        "2": { "name": "punctuation.definition.string.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.amber" }
      },
      "patterns": [
        { "include": "#string-escape-raw" }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.amber",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.amber" }
      },
      "patterns": [
        { "include": "#string-escape-double" },
        { "include": "#interpolation" }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.amber",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.amber" }
      },
      "patterns": [
        { "include": "#string-escape-single" }
      ]
    },
    "string-escape-double": {
      "name": "constant.character.escape.amber",
      "match": "\\\\(?:[nrt\\\\\"#]|u\\{[0-9A-Fa-f]{1,6}\\})"
    },
    "string-escape-single": {
      "name": "constant.character.escape.amber",
      "match": "\\\\(?:[nrt\\\\\"#']|u\\{[0-9A-Fa-f]{1,6}\\})"
    },
    "string-escape-raw": {
      "name": "constant.character.escape.regexp.amber",
      "match": "\\\\."
    },
    "interpolation": {
      "name": "meta.interpolation.amber",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.amber" }
      },
      "patterns": [
        { "include": "#balanced-braces" },
        { "include": "$self" }
      ]
    },
    "balanced-braces": {
      "name": "meta.brace.expression.amber",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.amber" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.amber" }
      },
      "patterns": [
        { "include": "#balanced-braces" },
        { "include": "$self" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.amber",
          "match": "(?<![\\p{L}\\p{N}_])0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.numeric.binary.amber",
          "match": "(?<![\\p{L}\\p{N}_])0[bB][01](?:_?[01])*(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.numeric.octal.amber",
          "match": "(?<![\\p{L}\\p{N}_])0[oO][0-7](?:_?[0-7])*(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.numeric.float.amber",
          "match": "(?<![\\p{L}\\p{N}_])(?:[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.numeric.integer.decimal.amber",
          "match": "(?<![\\p{L}\\p{N}_])[0-9](?:_?[0-9])*(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "constants": {
      "name": "constant.language.amber",
      "match": "(?<![\\p{L}\\p{N}_])(?:true|false|null)(?![\\p{L}\\p{N}_?!])"
    },
    "inline-conditional": {
      "name": "meta.conditional.inline.amber",
      "begin": "(?<![\\p{L}\\p{N}_])(if)(?![\\p{L}\\p{N}_?!])(?=[^#\\r\\n]*(?<![\\p{L}\\p{N}_])then(?![\\p{L}\\p{N}_?!]))",
      "end": "(?:(?<![\\p{L}\\p{N}_])(else)(?![\\p{L}\\p{N}_?!])|$)",
      "beginCaptures": {
        "1": { "name": "keyword.control.conditional.amber" }
      },
      "endCaptures": {
        "1": { "name": "keyword.control.conditional.amber" }
      },
      "patterns": [
        { "include": "#inline-then" },
        { "include": "$self" }
      ]
    },
    "inline-then": {
      "name": "keyword.control.conditional.amber",
      "match": "(?<![\\p{L}\\p{N}_])then(?![\\p{L}\\p{N}_?!])"
    },
    "callable-references": {
      "patterns": [
        {
          "name": "meta.function.reference.unbound.amber",
          "match": "(&)((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)*[\\p{L}_][\\p{L}\\p{N}_]*)(#)([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
          "captures": {
            "1": { "name": "keyword.operator.reference.amber" },
            "2": { "name": "entity.name.type.receiver.amber" },
            "3": { "name": "punctuation.accessor.unbound.amber" },
            "4": { "name": "entity.name.function.reference.amber" }
          }
        },
        {
          "name": "meta.function.reference.bound.amber",
          "match": "(&)((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)+)([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
          "captures": {
            "1": { "name": "keyword.operator.reference.amber" },
            "2": { "name": "entity.name.namespace.amber" },
            "3": { "name": "entity.name.function.reference.amber" }
          }
        },
        {
          "name": "meta.function.reference.binding.amber",
          "match": "(&)([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
          "captures": {
            "1": { "name": "keyword.operator.reference.amber" },
            "2": { "name": "entity.name.function.reference.amber" }
          }
        }
      ]
    },
    "definition-function": {
      "match": "(?<![\\p{L}\\p{N}_])(def)(?![\\p{L}\\p{N}_?!])\\s+(\\[\\]=?|\\*\\*|//|<=>|===|=~|!~|==|!=|<=|>=|<<|>>|[-+*/%&|^<>]|[\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
      "captures": {
        "1": { "name": "storage.type.function.amber" },
        "2": { "name": "entity.name.function.amber" }
      }
    },
    "definition-native-class": {
      "match": "(?<![\\p{L}\\p{N}_])(native)(?![\\p{L}\\p{N}_?!])\\s+(class)(?![\\p{L}\\p{N}_?!])\\s+([\\p{L}_][\\p{L}\\p{N}_]*)\\s+(from)(?![\\p{L}\\p{N}_?!])\\s+(\"(?:\\\\.|[^\"\\\\])*\")\\s+(owned|borrowed|collected)(?![\\p{L}\\p{N}_?!])",
      "captures": {
        "1": { "name": "storage.modifier.native.amber" },
        "2": { "name": "storage.type.class.amber" },
        "3": { "name": "entity.name.type.amber" },
        "4": { "name": "keyword.declaration.amber" },
        "5": { "name": "string.quoted.double.amber" },
        "6": { "name": "storage.modifier.ownership.amber" }
      }
    },
    "definition-class": {
      "match": "(?<![\\p{L}\\p{N}_])(class|mixin)(?![\\p{L}\\p{N}_?!])\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?:\\s*(<)\\s*((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)*[\\p{L}_][\\p{L}\\p{N}_]*))?",
      "captures": {
        "1": { "name": "storage.type.class.amber" },
        "2": { "name": "entity.name.type.amber" },
        "3": { "name": "keyword.operator.inheritance.amber" },
        "4": { "name": "entity.other.inherited-class.amber" }
      }
    },
    "definition-property": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(prop|class_prop)(?![\\p{L}\\p{N}_?!])\\s+([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
          "captures": {
            "1": { "name": "storage.type.property.amber" },
            "2": { "name": "entity.name.function.property.amber" }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(attr)(?![\\p{L}\\p{N}_?!])(?:\\s+(var|set)(?![\\p{L}\\p{N}_?!]))?\\s+([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
          "captures": {
            "1": { "name": "storage.type.property.amber" },
            "2": { "name": "storage.modifier.property.amber" },
            "3": { "name": "entity.name.function.property.amber" }
          }
        }
      ]
    },
    "member-call": {
      "match": "(?<=\\.)([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.member.amber" }
      }
    },
    "member-access": {
      "match": "(?<=\\.)([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
      "captures": {
        "1": { "name": "variable.other.member.amber" }
      }
    },
    "function-call": {
      "match": "([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.amber" }
      }
    },
    "command-call": {
      "match": "^\\s*((?!(?:and|attr|break|case!|case|catch|class|class_method|class_prop|def|do|elif|else|elsif|ensure|export|extend|false|from|if|import|in|include|loop|mixin|not|null|or|package|prop|raise|rescue|return|throw|true|try|unless|until|when|while)(?![\\p{L}\\p{N}_?!]))[\\p{L}_][\\p{L}\\p{N}_]*[?!]?)(?=\\s+(?:[\"'0-9:@$&\\[{]|true(?![\\p{L}\\p{N}_])|false(?![\\p{L}\\p{N}_])|null(?![\\p{L}\\p{N}_])))",
      "captures": {
        "1": { "name": "entity.name.function.call.amber" }
      }
    },
    "keyword-contextual": {
      "patterns": [
        {
          "name": "storage.modifier.native.amber",
          "match": "(?<![\\p{L}\\p{N}_])native(?![\\p{L}\\p{N}_?!])(?=\\s+(?:def|class)(?![\\p{L}\\p{N}_?!]))"
        },
        {
          "name": "storage.modifier.macro.amber",
          "match": "(?<![\\p{L}\\p{N}_])macro(?![\\p{L}\\p{N}_?!])(?=\\s+def(?![\\p{L}\\p{N}_?!]))"
        },
        {
          "name": "storage.modifier.string-tag.amber",
          "match": "(?<![\\p{L}\\p{N}_])string_tag(?![\\p{L}\\p{N}_?!])(?=\\s+macro\\s+def(?![\\p{L}\\p{N}_?!]))"
        },
        {
          "name": "keyword.operator.type.annotation.amber",
          "match": "(?<![\\p{L}\\p{N}_])as(?![\\p{L}\\p{N}_?!])"
        },
        {
          "name": "keyword.control.pattern.amber",
          "match": "(?<![\\p{L}\\p{N}_])pattern(?![\\p{L}\\p{N}_?!])(?=\\s*\\()"
        },
        {
          "name": "keyword.control.pattern.amber",
          "match": "(?<![\\p{L}\\p{N}_])with(?![\\p{L}\\p{N}_?!])(?=\\s*\\{)"
        },
        {
          "name": "keyword.other.directive.amber",
          "match": "^\\s*(numeric)(?![\\p{L}\\p{N}_?!])(?=\\s*:)"
        },
        {
          "name": "keyword.control.macro.amber",
          "match": "(?<![\\p{L}\\p{N}_])(quote)(?![\\p{L}\\p{N}_?!])(?=\\s*:\\s*$)"
        },
        {
          "name": "storage.modifier.property.amber",
          "match": "^\\s*(get|set)(?![\\p{L}\\p{N}_?!])(?=\\s*(?:\\([^\\r\\n]*\\))?\\s*:)"
        },
        {
          "name": "keyword.control.amber",
          "match": "^\\s*(next)(?![\\p{L}\\p{N}_?!])(?=\\s*(?:$|#|[\"'0-9@:$]|true(?![\\p{L}\\p{N}_])|false(?![\\p{L}\\p{N}_])|null(?![\\p{L}\\p{N}_])|[\\p{L}_]))"
        }
      ]
    },
    "keyword-control": {
      "name": "keyword.control.amber",
      "match": "(?<![\\p{L}\\p{N}_])(?:case!|if|elif|elsif|else|unless|while|until|loop|break|case|when|do|return)(?![\\p{L}\\p{N}_?!])"
    },
    "keyword-declaration": {
      "name": "keyword.declaration.amber",
      "match": "(?<![\\p{L}\\p{N}_])(?:class_method|class_prop|def|class|mixin|prop|attr|package|import|include|from|export|extend)(?![\\p{L}\\p{N}_?!])"
    },
    "keyword-exception": {
      "name": "keyword.control.exception.amber",
      "match": "(?<![\\p{L}\\p{N}_])(?:try|catch|rescue|ensure|raise|throw)(?![\\p{L}\\p{N}_?!])"
    },
    "keyword-operator-word": {
      "patterns": [
        {
          "name": "keyword.operator.logical.amber",
          "match": "(?<![\\p{L}\\p{N}_])(?:and|or|not)(?![\\p{L}\\p{N}_?!])"
        },
        {
          "name": "keyword.operator.relational.amber",
          "match": "(?<![\\p{L}\\p{N}_])in(?![\\p{L}\\p{N}_?!])"
        }
      ]
    },
    "special-variables": {
      "patterns": [
        {
          "name": "variable.language.last-value.amber",
          "match": "\\$_"
        },
        {
          "name": "variable.parameter.placeholder.amber",
          "match": "(?<![\\p{L}\\p{N}_])_[0-9]+(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "variable.language.self.amber",
          "match": "(?<![\\p{L}\\p{N}_])self(?![\\p{L}\\p{N}_?!])"
        },
        {
          "name": "variable.language.wildcard.amber",
          "match": "(?<![\\p{L}\\p{N}_])_(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.class.amber",
          "match": "@@[\\p{L}_][\\p{L}\\p{N}_]*[?!]?"
        },
        {
          "name": "variable.other.member.amber",
          "match": "@[\\p{L}_][\\p{L}\\p{N}_]*[?!]?"
        }
      ]
    },
    "symbols": {
      "match": "(:(?!:))([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)",
      "captures": {
        "1": { "name": "punctuation.definition.constant.symbol.amber" },
        "2": { "name": "constant.other.symbol.amber" }
      }
    },
    "types": {
      "name": "entity.name.type.amber",
      "match": "(?<![\\p{L}\\p{N}_])\\p{Lu}[\\p{L}\\p{N}_]*\\??"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.navigation.safe.amber",
          "match": "\\.\\?\\."
        },
        {
          "name": "keyword.operator.range.amber",
          "match": "\\.\\.\\.?"
        },
        {
          "name": "keyword.operator.optional-access.amber",
          "match": "\\?(?=\\s*\\[)"
        },
        {
          "name": "keyword.operator.effect.amber",
          "match": "!(?=\\s*\\{)"
        },
        {
          "name": "keyword.operator.amber",
          "match": "//=|\\+=|-=|\\*=|/=|%=|===|<=>|<<|>>|\\*\\*|//|=~|!~|==|!=|<=|>=|->|\\?\\?|[-+*/%<>=&|^]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.dot.amber",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.amber",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.section.brackets.amber",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
