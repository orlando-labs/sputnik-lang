package native.sequence_core

export main

def main():
  score = 0
  xs = [3, 1, 2]
  if xs.count() == 3 and xs.first() == 3 and xs.first(2)[1] == 1:
    score = score + 1
  if xs[?2] == 2 and xs[?3] == null and xs[?-1] == 2 and xs.has_index?(3) == false:
    score = score + 1
  xs[1] = 5
  if xs[1] == 5 and xs[-1] == 2:
    score = score + 1
  built = xs.appended(9, 8).inserted(1, 7, 6).deleted(5)
  if built.count() == 6 and built[1] == 7 and built[2] == 6 and built[-1] == 8:
    score = score + 1
  if built.reversed()[0] == 8 and built.take(2)[1] == 7 and built.drop(4)[0] == 9:
    score = score + 1
  combo = built.take(2).concat([10])
  if combo[2] == 10 and ([1, 2] * 2)[2] == 1:
    score = score + 1
  sorted = [3, 1, 2].sorted()
  if sorted[0] == 1 and sorted[2] == 3:
    score = score + 1
  words = ["b", "a", "c"].sorted()
  if words[0] == "a" and words[2] == "c":
    score = score + 1
  pairs = [(2, 0), (1, 9), (1, 3)].sorted()
  if pairs[0][0] == 1 and pairs[0][1] == 3 and pairs[2][0] == 2:
    score = score + 1
  mm = [3, 1, 4].minmax()
  if [3, 1, 4].min() == 1 and [3, 1, 4].max() == 4 and mm[0] == 1 and mm[1] == 4:
    score = score + 1
  tuple = (7, 8, 9)
  if tuple.count() == 3 and tuple[1] == 8 and tuple.to_array()[2] == 9:
    score = score + 1
  if tuple.deconstruct()[0] == 7 and tuple.first(2)[1] == 8:
    score = score + 1
  if built.take(2).to_str() == "[3, 7]" and tuple.to_str() == "(7, 8, 9)":
    score = score + 1
  r = (1..5).to_array()
  if r.count() == 5 and r[4] == 5 and (1..5).first() == 1:
    score = score + 1
  stepped = Range.new(1, 5, step: 2).to_array()
  if stepped.count() == 3 and stepped[2] == 5:
    score = score + 1
  descending = Range.new(5, 1, step: -2).to_array()
  if descending.count() == 3 and descending[2] == 1:
    score = score + 1
  if [1, 2, 3].contains?(2) and [1, 2, 3].member?(4) == false:
    score = score + 1
  if [].empty?() and Range.new(5, 1).empty?():
    score = score + 1
  indices = 3.times()
  if indices.count() == 3 and indices[0] == 0 and indices[2] == 2:
    score = score + 1
  total = 0
  4.times |index|:
    total = total + index
  if total == 6:
    score = score + 1

  generated = Array.of(4): _1 + 1
  rebuilt = Array.build(3): _1 * 2
  filled = Array.filled(2, false)
  if generated == [1, 2, 3, 4] and rebuilt == [0, 2, 4] and filled == [false, false]:
    score = score + 1

  mutable = [3, 1, 2, 2]
  alias_of_mutable = mutable
  mutable.unshift!(0)
  mutable.insert!(2, 9)
  removed = mutable.delete!(2)
  first_removed = mutable.shift!()
  last_removed = mutable.pop!()
  mutable.push!(4)
  mutable.sort!()
  mutable.reverse!()
  mutable.uniq!()
  if removed == 2 and first_removed == 0 and last_removed == 1 and alias_of_mutable == [9, 4, 3]:
    score = score + 1

  transformed = [1, 2, 3, 4]
  transformed.select!: _1 > 1
  transformed.map!: _1 * 10
  transformed.delete_if!: _1 == 30
  transformed.keep_if!: _1 <= 40
  transformed.append!(50)
  deleted_at = transformed.delete_at!(0)
  transformed.replace!([7, null, [8, [9]]])
  transformed.compact!()
  transformed.flatten!()
  transformed.clear!()
  if deleted_at == 20 and transformed.empty?():
    score = score + 1

  union_operator = [1, 2] | [2, 3]
  intersection_operator = [1, 2, 3] & [2, 4]
  difference_operator = [1, 2, 3] - [2]
  symmetric_operator = [1, 2] ^ [2, 3]
  if union_operator == [1, 2, 3] and intersection_operator == [2] and difference_operator == [1, 3] and symmetric_operator == [1, 3] and [1, 2] < [1, 2, 3] and [1, 2] <= [2, 1]:
    score = score + 1

  windows = [1, 2, 3, 4].each(2, step: 1)
  slices = [1, 2, 3, 4].each_slice(2)
  descending_sorted = [1, 3, 2].sorted(reverse: true)
  mutable_sorted = [1, 4, 2, 3]
  mutable_sorted.sort!(reverse: true)
  mutable_unique = [1, 3, 2, 4]
  mutable_unique.uniq!: _1 % 2
  if windows == [[1, 2], [2, 3], [3, 4]] and slices == [[1, 2], [3, 4]] and descending_sorted == [3, 2, 1] and mutable_sorted == [4, 3, 2, 1] and mutable_unique == [1, 2]:
    score = score + 1
  score
