class Array:
  def hello(): 42

class Range:
  def bye(): 43

define_method(Array, :hello2) |receiver|:
  44

def main():
  if "a" + "b" != "ab":
    raise ValueError("bad str")
  if [1, 2].hello != 42:
    raise ValueError("bad")
  if (1..2).bye != 43:
    raise ValueError("bad range")
  if [1, 2].hello2 != 44:
    raise ValueError("bad dynamic")
  0
