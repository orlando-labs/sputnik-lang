{
  "format": "amber-notebook",
  "version": 2,
  "title": "Interactive Inputs",
  "active_sheet": "main",
  "sheets": [{
    "id": "main", "title": "Controller", "cells": [
      {"id":"1", "kind":"code", "mode":"watch", "source":"gain = notebook.input(\"gain\")\nvalue = gain * 21\nvalue\n"},
      {"id":"2", "kind":"code", "mode":"manual", "source":"snapshot = notebook.input(\"gain\") * 21\nsnapshot\n"}
    ]
  }],
  "modules": [],
  "auto_imports": [],
  "inputs": [{"id":"gain", "title":"Gain", "type":"number", "default":2.0, "minimum":0, "maximum":100}],
  "boards": [{
    "id":"dashboard", "title":"Interactive Inputs", "sheet":"main", "columns":2,
    "components":[
      {"id":"gain_control", "kind":"input", "title":"Parameter", "input":"gain"},
      {"id":"computed", "kind":"text", "title":"Live value", "cell":"1", "binding":"value"},
      {"id":"refresh", "kind":"run", "title":"Refresh snapshot", "cell":"2"},
      {"id":"snapshot", "kind":"text", "title":"Manual snapshot", "cell":"2", "binding":"snapshot"}
    ]
  }]
}
